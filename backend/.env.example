# Required for AI-generated resume suggestions.
GEMINI_API_KEY=replace_with_your_key

# Optional: override the default production model.
GEMINI_MODEL=gemini-3.7-flash

# Optional local database location. Hugging Face Docker sets /data/evaluations.db.
# SKILLSYNCER_DB_PATH=./backend/app/evaluations.db

# Comma-separated origins. Use * for development or set your deployed frontend origin.
CORS_ORIGINS=*
